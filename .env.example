# ── SUPABASE CONNECTION ──
# Get these from: Supabase Project Settings > Database > Connection String > URI
# 1. DATABASE_URL: Use the "Session Pooler" (Port 6543)
# 2. DIRECT_URL: Use the "Direct Connection" (Port 5432)

DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ── NEXTAUTH AUTHENTICATION ──
# Run `openssl rand -base64 32` to generate a secret
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# ── EMAIL SERVICE (Optional for now) ──
# RESEND_API_KEY="re_..."
